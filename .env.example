# Local provider credentials. Keep real values only in .env (which is ignored).
GROQ_API_KEY=""
GEMINI_API_KEY=""

# Optional service overrides.
VIDSCRIBE_HOST="127.0.0.1"
VIDSCRIBE_PORT="8000"
# VIDSCRIBE_DATA_DIR="$HOME/Library/Application Support/Vidscribe"
VIDSCRIBE_GROQ_MODEL="whisper-large-v3-turbo"
VIDSCRIBE_GEMINI_MODEL="gemini-3-flash-preview"
VIDSCRIBE_GEMINI_EFFORT="medium"

# Vite talks only to the local service.
VITE_API_BASE_URL="http://127.0.0.1:8000"
